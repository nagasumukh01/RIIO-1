# Experiment runtime outputs (regenerated on each run)
artifacts/experiment_logs/*.db
artifacts/experiment_logs/*.log
artifacts/experiment_logs/run_ml_smoke.py

# Keep directory structure
!artifacts/checkpoints/.gitkeep
!artifacts/experiment_logs/.gitkeep
!artifacts/figures/.gitkeep
!data/.gitkeep

